{
  "schemaVersion": 1,
  "provider": "cloudflare-workers-builds",
  "repository": "Trigenys/trigenys-editorial-os",
  "workerName": "trigenys-editorial-os-staging-api",
  "rootDirectory": "/backend",
  "buildCommand": "bash scripts/package_worker.sh dry-run wrangler.production.toml ../worker-dist-production",
  "deployCommand": "bash scripts/package_worker.sh deploy wrangler.production.toml",
  "environment": "staging"
}
