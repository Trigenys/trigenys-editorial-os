{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trigenys-editorial-os-staging-spike",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/health/*",
      "/docs",
      "/docs/*",
      "/redoc",
      "/redoc/*",
      "/openapi.json"
    ]
  },
  // CI uses a non-production placeholder ID. A live staging deploy MUST replace it.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "vars": {
    "EDITORIAL_OS_PAYLOAD_ENABLED": "false"
  }
}
